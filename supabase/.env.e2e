# Edge Function settings for the Maestro flows only: `npm run e2e` serves the functions with this
# file (scripts/functions.sh e2e) instead of supabase/.env. No secrets here.
# DRAFT_FIXTURES=1: build-draft and refresh-source-video read canned TikTok and YouTube videos, web
# pages and Claude answers (supabase/functions/_shared/draft-fixtures.ts) instead of the real ones,
# so flows make no network calls. The functions refuse it unless the stack is local.
DRAFT_FIXTURES=1
