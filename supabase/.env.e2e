# Edge Function settings for the Maestro flows only: `npm run e2e` serves the functions with this
# file (scripts/functions.sh e2e) instead of supabase/.env. No secrets here.
# DRAFT_FIXTURES=1: build-draft reads canned TikTok captions and canned Claude answers
# (supabase/functions/_shared/draft-fixtures.ts) instead of TikTok and Claude, so flows make no
# network calls. The function refuses it unless the stack is local.
DRAFT_FIXTURES=1
