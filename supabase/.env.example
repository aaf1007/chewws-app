# Copy to supabase/.env (git-ignored). The Supabase CLI reads it for env(...) values in config.toml.
# Restart the stack after changing it: npm run db:stop && npm run db:start

# Sign in with Apple (native). Only needed for the web OAuth flow; leave empty for this app.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Sign in with Google. Web client id first, then the iOS client id, comma-separated.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# The web client's secret from Google Cloud Console.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
