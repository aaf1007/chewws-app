# Copy to .env.local (git-ignored). Values below match the local stack from `npm run db:start`;
# `supabase status` prints them. The local anon key is the CLI's shared demo key, not a secret.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Google sign-in. Leave empty to build without it; the app then shows "not configured".
# iOS client id, e.g. 1234-abcd.apps.googleusercontent.com (also sets the URL scheme at prebuild).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web client id; Supabase checks the ID token against it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
